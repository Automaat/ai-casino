# syntax=docker/dockerfile:1
# Development Dockerfile for Svelte frontend with HMR
FROM node:24-alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Copy source code (will be overridden by volume mounts)
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Generate .svelte-kit directory and start dev server with HMR
CMD ["sh", "-c", "npx svelte-kit sync && npm run dev -- --host 0.0.0.0"]
