{
	"name": "ai-casino-frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint --deny-warnings src",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"generate-api": "openapi --input http://localhost:8484/openapi.json --output ./src/lib/api --client fetch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/svelte": "^5.3.1",
		"@types/d3": "^7.4.3",
		"@vitest/ui": "^4.0.18",
		"autoprefixer": "^10.4.24",
		"date-fns": "^4.1.0",
		"jsdom": "^28.0.0",
		"openapi-typescript-codegen": "^0.30.0",
		"oxlint": "^1.46.0",
		"postcss": "^8.5.6",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^8.0.0-beta.7",
		"vitest": "^4.0.18"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"echarts": "^6.0.0",
		"lightweight-charts": "^5.1.0"
	}
}
