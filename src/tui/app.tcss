/* AI Casino TUI Theme - Nord */

/* Screen base - uses theme colors */
Screen {
    background: $background;
    color: $foreground;
}

/* Remove default header styling */
Header {
    display: none;
}

/* Remove footer */
Footer {
    display: none;
}

/* Main chat container - NO borders, clean look */
#chat-container {
    height: 1fr;
    background: $background;
    padding: 0 1;
    border: none;
}

ChatView {
    height: 1fr;
    background: $background;
    padding: 0;
    border: none;
}

/* Welcome/Logo area */
.logo {
    color: $accent;
    margin-bottom: 1;
}

.welcome-text {
    color: $text-muted;
    margin-bottom: 0;
}

.model-info {
    color: $text-muted;
}

.model-name {
    color: $accent;
}

/* User message - highlighted with prompt */
UserMessage {
    background: transparent;
    padding: 0;
    margin: 1 0 0 0;
    border: none;
}

.user-prompt {
    color: $accent;
}

.user-input {
    background: $surface;
    padding: 0 1;
}

/* Assistant message - clean, no background */
AssistantMessage {
    background: transparent;
    padding: 0;
    margin: 1 0;
    border: none;
    color: $foreground;
}

AssistantMessage.streaming {
    color: $text-muted;
}

/* Tool call indicator - accent with bullet */
ToolCallWidget {
    color: $accent;
    padding: 0;
    margin: 1 0 0 0;
}

.tool-name {
    color: $accent;
}

.tool-args {
    color: $text-muted;
}

.tool-timing {
    color: $accent;
}

/* Response text */
.response-text {
    color: $foreground;
    margin: 1 0;
}

/* Progress panel - minimal */
ProgressPanel {
    background: transparent;
    border: none;
    padding: 0;
    margin: 1 0;
}

ProgressPanel LoadingIndicator {
    color: $accent;
    height: 1;
}

.progress-header {
    color: $accent;
}

/* Task steps */
TaskStep {
    padding: 0;
    height: 1;
}

TaskStep.pending {
    color: $text-disabled;
}

TaskStep.active {
    color: $accent;
}

TaskStep.complete {
    color: $accent;
}

/* Result box - minimal table style */
ResultBox {
    background: transparent;
    border: none;
    padding: 0;
    margin: 1 0;
}

.result-header {
    color: $foreground;
    text-style: bold;
    margin-bottom: 1;
}

.result-table {
    margin: 1 0;
}

.result-row {
    height: 1;
}

.result-label {
    color: $text-muted;
    width: 15;
}

.result-value {
    color: $foreground;
}

/* Signal colors - Nord Aurora */
.signal-buy {
    color: #A3BE8C;
}

.signal-sell {
    color: #BF616A;
}

.signal-hold {
    color: #EBCB8B;
}

/* Autocomplete input container */
#input-box {
    dock: bottom;
    height: auto;
    max-height: 15;
    margin: 0 1 1 1;
}

#autocomplete-container {
    height: auto;
    max-height: 14;
}

#autocomplete-input {
    background: $background;
    border: solid $panel;
    color: $foreground;
}

#autocomplete-input:focus {
    border: solid $accent;
}

#autocomplete-input.-placeholder {
    color: $text-disabled;
}

/* Dropdown list */
#autocomplete-dropdown {
    height: auto;
    max-height: 10;
    background: $surface;
    border: solid $panel;
    margin-bottom: 1;
}

#autocomplete-dropdown:focus {
    border: solid $accent;
}

#autocomplete-dropdown > .option-list--option {
    padding: 0 1;
}

#autocomplete-dropdown > .option-list--option-highlighted {
    background: $accent;
    color: $background;
}

/* Status bar - minimal */
StatusBar {
    dock: bottom;
    height: 1;
    background: transparent;
    color: $text-disabled;
    padding: 0 1;
}
