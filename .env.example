# LLM Configuration
# For local development with Ollama (free)
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434
LLM_MAX_CONCURRENT=5  # Concurrent LLM requests (1-20, 5 recommended, 1=serialized)

# For production with Claude (switch provider)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_KEY=sk-ant-...

# For production with OpenAI (alternative)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=sk-...

# Market Data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Market Events & Earnings
FINNHUB_API_KEY=your_finnhub_key_here  # Optional - free tier available

# News Data
MARKETAUX_API_KEY=your_marketaux_key_here  # Optional - has free tier

# Social Sentiment
REDDIT_CLIENT_ID=your_reddit_client_id_here  # Optional
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here  # Optional
REDDIT_USER_AGENT=ai-casino-bot/0.1  # Optional - override default Reddit user agent

# Paper Trading
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Risk Management
MAX_POSITION_RISK=2.0  # Maximum % of account to risk per trade
MAX_EXPOSURE=80.0  # Maximum % of account in open positions
MAX_SINGLE_POSITION=20.0  # Maximum % of account for single position

# Logging
LOG_LEVEL=INFO

# Database - PostgreSQL configured in daemon.yaml
# For local development outside docker:
# DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5432/ai_casino_dev
# Note: Production uses database_url in daemon-production.yaml

# Portfolio Snapshots
PORTFOLIO_SNAPSHOT_ON_TRADE=false  # Capture snapshot after each trade

# Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
