# AI Casino Daemon Configuration
# Copy to daemon.yaml and customize

daemon:
  # Stocks to analyze
  watchlist: ["AAPL", "TSLA", "GOOGL", "MSFT", "NVDA"]

  # Analysis interval in minutes
  interval_minutes: 30

  # Only run during market hours
  market_hours_only: true

  # Auto-execute trades (requires Alpaca credentials)
  auto_trade: false

  # Maximum concurrent analyses
  max_concurrent_analyses: 3

  # Trading mode: "paper" (default) or "live"
  # WARNING: "live" mode requires passing paper trading validation
  trading_mode: "paper"

  paper_trading:
    # Minimum duration in paper trading before live promotion (days)
    min_duration_days: 30
    # Minimum number of executed trades
    min_trades: 20
    # Minimum Sharpe ratio required
    min_sharpe: 0.5
    # Maximum drawdown allowed (percent)
    max_drawdown_percent: 15.0
    # Minimum win rate required (0.0-1.0)
    min_win_rate: 0.45

  schedule:
    # Market hours (Eastern Time)
    start_time: "09:30"
    end_time: "16:00"
    timezone: "America/New_York"

  state:
    # State persistence file
    state_file: "~/.ai-casino/daemon-state.json"

  journal:
    # After-hours trade journal
    enabled: true
    journal_dir: "~/.ai-casino/journal"
    run_offset_minutes: 15

  optimization:
    # After-hours strategy parameter optimization
    enabled: false
    # Time to run optimization (HH:MM, in schedule timezone)
    optimization_time: "17:00"
    # Days to run optimization (mon/tue/wed/thu/fri/sat/sun)
    optimization_days: ["sat"]
    # Optuna trials per symbol-strategy pair
    n_trials: 100
    # Minimum trades in validation backtest to accept params
    min_trades: 100
    # File to store optimized parameters
    params_file: "~/.ai-casino/optimized-params.json"
    # Skip re-optimization if params are newer than this (days)
    refresh_days: 30
    # Strategies to optimize per symbol
    strategies: ["momentum", "mean_reversion", "trend_following"]

  earnings_calendar:
    # Earnings calendar preparation (flag upcoming earnings, adjust risk)
    enabled: false
    # Time to fetch earnings calendar (HH:MM, in schedule timezone)
    fetch_time: "16:45"
    # Days to fetch (weekly refresh is sufficient)
    fetch_days: ["mon"]
    # Days ahead to flag upcoming earnings
    lookahead_days: 3
    # Reduce position size T-1 day before earnings
    reduce_position_t1: false
    # Position reduction factor (0.5 = halve position size)
    position_reduction_factor: 0.5

  peer_analysis:
    # Weekly deep peer benchmarking (compare positions vs sector peers)
    # Requires ALPHA_VANTAGE_API_KEY env var
    enabled: false
    # Time to run analysis (HH:MM, in schedule timezone)
    run_time: "17:30"
    # Days to run (weekly is sufficient, Sunday avoids market hours)
    run_days: ["sun"]
    # Maximum peers to compare per position
    max_peers: 10
    # Output directory for analysis results
    output_dir: "~/.ai-casino/peer-analysis"
    # Seconds between API calls (Alpha Vantage rate limit)
    rate_limit_sleep: 13.0

  prefetch:
    # After-hours data prefetching (warm cache for morning)
    # Requires ALPHA_VANTAGE_API_KEY env var
    enabled: false
    # Time to prefetch after market close (HH:MM, in schedule timezone)
    prefetch_time: "16:30"
    # Refresh cache before pre-market session
    enable_pre_market_refresh: false
    # Time to refresh pre-market data
    pre_market_refresh_time: "04:00"
    # Warm FinBERT model during prefetch
    warm_finbert: true
    # Check API connectivity during prefetch
    check_connectivity: true

  monte_carlo:
    # Monte Carlo stress testing
    enabled: false
    # Time to run stress test (HH:MM, 16:00-20:00 for weekdays, any time for weekends)
    schedule_time: "17:00"
    # Days to run stress test (mon/tue/wed/thu/fri/sat/sun)
    schedule_days: ["sun"]
    # Number of simulation paths (100-10000)
    num_simulations: 5000
    # Simulation horizon in trading days (1-504)
    horizon_days: 252
    # Simulation method: PARAMETRIC (normal dist), BOOTSTRAP (historical), or GBM (geometric brownian motion)
    simulation_method: "PARAMETRIC"
    # Minimum historical days required for simulation
    min_historical_days: 90
    # Loss threshold for alerts (0.0-1.0)
    loss_threshold: 0.10
    # Maximum acceptable probability of exceeding loss threshold
    max_acceptable_prob: 0.15
    # Enable automatic position sizing adjustment based on stress test results (opt-in)
    adjust_position_sizing: false

  notifications:
    # Push notifications for trading signals and risk alerts
    enabled: false
    # Notification channels to use (telegram only in MVP)
    channels: ["telegram"]
    # Minimum confidence threshold for signal notifications (0.0-1.0)
    min_confidence: 0.7
    # Events to notify on
    notify_on: ["signal", "risk_rejection", "portfolio_var_breach", "health_failure"]
    # Rate limiting
    rate_limit_enabled: true
    rate_limit_per_symbol_minutes: 60

    telegram:
      # Telegram bot token (or set TELEGRAM_BOT_TOKEN env var)
      # bot_token: "your_bot_token_here"
      # Telegram chat ID (or set TELEGRAM_CHAT_ID env var)
      # chat_id: "your_chat_id_here"

  # LLM Provider Configuration (optional, falls back to environment variables)
  llm:
    # provider: "ollama"      # Falls back to LLM_PROVIDER (ollama, anthropic, openai)
    # model: "qwen3:14b"      # Falls back to LLM_MODEL

  # API Keys Configuration (optional, falls back to environment variables)
  # Config keys take priority over env vars when both are present
  api_keys:
    # Data providers
    # alpha_vantage_api_key: "YOUR_KEY_HERE"  # Falls back to ALPHA_VANTAGE_API_KEY
    # marketaux_api_key: "YOUR_KEY_HERE"      # Falls back to MARKETAUX_API_KEY
    # finnhub_api_key: "YOUR_KEY_HERE"        # Falls back to FINNHUB_API_KEY

    # Broker credentials (paper and live)
    # alpaca_api_key: "YOUR_KEY_HERE"         # Falls back to ALPACA_API_KEY
    # alpaca_secret_key: "YOUR_SECRET_HERE"   # Falls back to ALPACA_SECRET_KEY
    # alpaca_paper_api_key: "YOUR_PAPER_KEY_HERE"      # Falls back to ALPACA_PAPER_API_KEY (optional override)
    # alpaca_paper_secret_key: "YOUR_PAPER_SECRET_HERE"  # Falls back to ALPACA_PAPER_SECRET_KEY (optional override)

    # Social media
    # reddit_client_id: "YOUR_CLIENT_ID"      # Falls back to REDDIT_CLIENT_ID
    # reddit_client_secret: "YOUR_CLIENT_SECRET"  # Falls back to REDDIT_CLIENT_SECRET
    # reddit_user_agent: "ai-casino/1.0"      # Falls back to REDDIT_USER_AGENT

    # LLM providers (choose one based on LLM_PROVIDER setting)
    # anthropic_api_key: "YOUR_ANTHROPIC_KEY"  # Falls back to ANTHROPIC_API_KEY
    # openai_api_key: "YOUR_OPENAI_KEY"       # Falls back to OPENAI_API_KEY
    # openai_api_base: "https://api.openai.com/v1"  # Falls back to OPENAI_API_BASE (optional custom endpoint)
